    "types": "cargo test --workspace --lib export_bindings"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@lucide/svelte": "1.70.0",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.2",
    "country-flag-emoji-polyfill": "0.1.10",
    "emojibase-data": "18.0.0",
    "sass": "1.108.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }

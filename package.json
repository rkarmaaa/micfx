{
  "name": "micfx",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:ui": "vite --config ui/vite.config.ts",

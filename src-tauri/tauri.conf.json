{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MicFX",
  "version": "1.3.0",
  "identifier": "com.micfx.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMjk5NEMxRTg5Q0IwMzUKUldRMXNKem93WlFwelQ5N0JHbTVvNUJqYktJZS9hMCtBS0FWS0tiTi9sQlNvSTdvN3VzSy81eWwK",
      "endpoints": ["https://github.com/rkarmaaa/micfx/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Marco",
    "shortDescription": "Soundboard per Discord con microfono virtuale",
    "longDescription": "MicFX riproduce suoni dentro un microfono virtuale (VB-Cable su Windows, BlackHole su Mac): li senti tu in cuffia e li sentono i tuoi amici su Discord, insieme alla tua voce.",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
